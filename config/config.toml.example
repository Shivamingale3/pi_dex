[telegram]
# Set these via environment variables instead:
#   TELEGRAM_BOT_TOKEN=your_bot_token
#   TELEGRAM_CHAT_ID=your_chat_id
# Or uncomment and fill in below:
# bot_token = "your_telegram_bot_token_here"
# chat_id = "your_telegram_chat_id_here"

[monitor]
ssh = true
sudo = true
docker = true
systemd = true
network = true
shutdown = true
cpu = true
ram = true
disk = true
temperature = true

[services]
watch = ["cloudflared", "docker", "nginx", "caddy", "tailscale"]

[containers]
watch = []

[pollers]
cpu_interval = 15
ram_interval = 30
temp_interval = 30
disk_interval = 300

[thresholds]
cpu_warn = 80
cpu_critical = 95
ram_warn = 85
ram_critical = 95
disk_warn = 85
disk_critical = 95
temp_warn = 75
temp_critical = 85

[cooldowns]
SSH_LOGIN = 0
SSH_LOGOUT = 0
SSH_BRUTEFORCE = 300
SUDO_USED = 0
CPU_HIGH = 300
CPU_RECOVERED = 300
TEMP_WARN = 300
TEMP_CRITICAL = 300
DISK_WARN = 3600
DISK_CRITICAL = 3600
RAM_HIGH = 300

# Health checks: each runs in its own goroutine on its own interval.
# An alert (CRITICAL) fires after `failures` consecutive failures, with a
# diagnosis and the last log lines; a RECOVERED alert fires when it passes again.
#
# Fields:
#   name          unique, required
#   type          http | tcp | redis | systemd | docker | command | interface
#   address       http: full URL; tcp/redis: host:port
#   unit          systemd unit (required for type systemd; else optional, for diagnosis + logs)
#   container     docker container (required for type docker; else optional, for diagnosis + logs)
#   interface     network interface (required for type interface; else optional, for diagnosis)
#   interval      seconds between checks, default 30, minimum 5
#   timeout       seconds, default 5
#   failures      consecutive failures before alerting, default 3
#   username      redis ACL user (optional)
#   password      redis AUTH (optional)
#   expect_status http only, default 200
#   headers       http only, e.g. headers = { Authorization = "Bearer ..." }
#   command       command only: run via /bin/sh -c, exit 0 = healthy
#
# password and headers are secrets: keep this file root:pidex mode 0640.
# Manage checks with: sudo pidex setup -> 11. Manage health checks
# Run one now with:   sudo pidex test --health <name>

[[health_checks]]
name = "tailscale-ip"
type = "interface"
interface = "tailscale0"
interval = 30
failures = 6          # 3 min grace at boot

[[health_checks]]
name = "redis-cache"
type = "redis"
address = "100.83.1.25:6379"
unit = "redis-cache.service"
interface = "tailscale0"
